<?xml version="1.0" encoding="utf-8"?>
<!-- The WebView talks plain HTTP to the server in this process, on loopback only.
     Everything else keeps the platform default (no cleartext). The Rust server's own
     outgoing requests (update check, DynDNS) use rustls and are not affected. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
