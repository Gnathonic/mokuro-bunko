<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The server listens on a TCP port; the update check and DynDNS go out. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The LAN address shown on the settings screen. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Keep serving with the screen off: partial wake lock + Wi-Fi lock. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+: a long-running local server fits no predefined FGS type; see
         docs/rust-port/MOBILE.md for why specialUse rather than dataSync. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+: the ongoing "server running" notification. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- hasFragileUserData: the library lives in app storage, so uninstalling offers to
         keep it. allowBackup off: a manga library is far too large for Auto Backup. -->
    <application
        android:name=".BunkoApp"
        android:allowBackup="false"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bunko">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".LicensesActivity"
            android:exported="false"
            android:label="@string/licences"
            android:parentActivityName=".SettingsActivity" />

        <service
            android:name=".ServerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Self-hosted manga library server: serves the user's own library over HTTP/WebDAV to their reading apps and devices while it runs; started and stopped explicitly by the user." />
        </service>
    </application>
</manifest>
