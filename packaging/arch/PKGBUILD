# Maintainer: Gnathonic <https://github.com/Gnathonic>
#
# mokuro-bunko (full build: server, local OCR, processor) and its desktop tray.
#
# Source: the release tag from GitHub. To build a local checkout instead (its HEAD
# commit; uncommitted changes are not included), point BUNKO_SOURCE at it:
#
#   cd packaging/arch
#   BUNKO_SOURCE="git+file://$(git rev-parse --show-toplevel)#commit=$(git rev-parse HEAD)" makepkg -si
#
# The release tarball works too (for an AUR package without git): replace the
# `source`/`sha256sums` lines with
#
#   source=("$pkgname-$_pkgver.tar.gz::$url/archive/refs/tags/v$_pkgver.tar.gz")
#   sha256sums=('<sha256sum of that tarball>')
#
# and set `_src=$pkgname-$_pkgver`.
#
# Updates come from pacman: an executable in /usr/bin counts as package-managed
# (bunko-update InstallKind), so `mokuro-bunko update apply`, the admin panel and the
# app's settings page report new releases but never replace these files.
#
# OCR backend packs (libtorch for the GPU/CPU recognizers) are not part of this
# package: `mokuro-bunko install-ocr` installs the one that fits the hardware into
# the user's storage (README "OCR", /usr/share/doc/mokuro-bunko/README.md).
#
# Network during build(): ort-sys downloads its prebuilt static ONNX Runtime (pinned
# and sha256-checked by its build script, cached in ~/.cache/ort.pyke.io).

pkgname=mokuro-bunko
_pkgver=0.7.0-alpha.1
pkgver=${_pkgver//-/}
pkgrel=1
pkgdesc='Self-hosted manga library server with WebDAV, local OCR and a desktop tray'
arch=('x86_64')
url='https://github.com/Gnathonic/mokuro-bunko'
# mokuro-bunko's own licence. The binaries also contain permissively licensed crates
# and C libraries (ONNX Runtime, libjpeg-turbo, SQLite, ...): their texts are in
# /usr/share/licenses/mokuro-bunko/THIRD-PARTY-LICENSES.md.
license=('MPL-2.0')
depends=(
  'cairo'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libgcc'
  'libstdc++'
  # dlopen()ed by the tray at run time (libappindicator3.so.1 works too), so namcap
  # cannot see it.
  'libayatana-appindicator'
)
makedepends=(
  'cargo'
  'git'
  'nasm'
)
optdepends=(
  'numactl: AMD GPU OCR (the rocm7.1 backend pack loads libnuma.so)'
  'libelf: AMD GPU OCR (the rocm7.1 backend pack links libelf and libdw)'
  'nvidia-utils: NVIDIA GPU OCR (the cu130 backend pack needs driver 580 or newer)'
)
options=('!lto')

source=("$pkgname::${BUNKO_SOURCE:-git+$url.git#tag=v$_pkgver}")
sha256sums=('SKIP')
_src=$pkgname

_cargo_env() {
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Panic messages name source files: keep the build directory out of the binaries.
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/usr/src/debug/$pkgname"
}

prepare() {
  cd "$_src"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd "$_src"
  _cargo_env
  # Two builds, as the release archives do: the tray must not pick up the server's
  # features of shared crates (resolver 3 unifies features within one invocation).
  cargo build --frozen --release -p mokuro-bunko --bin mokuro-bunko
  cargo build --frozen --release -p bunko-tray --bin mokuro-bunko-tray
  # THIRD-PARTY-LICENSES.md for exactly this build (CLI full + tray); fails on
  # copyleft dependencies.
  CARGO_NET_OFFLINE=true cargo run --frozen --release -p xtask -- \
    licenses --flavor full --out THIRD-PARTY-LICENSES.md
}

check() {
  cd "$_src"
  _cargo_env
  cargo test --frozen --release -p bunko-update -p bunko-tray
  target/release/mokuro-bunko --version
  target/release/mokuro-bunko-tray --version
}

package() {
  cd "$_src"
  install -Dm755 -t "$pkgdir/usr/bin" \
    target/release/mokuro-bunko \
    target/release/mokuro-bunko-tray

  # Menu entry. No autostart entry: the tray's "Start at login" (or the setup
  # wizard's "Run from the tray when I log in") writes the user's own.
  sed 's|@EXEC@|mokuro-bunko-tray|' packaging/linux/mokuro-bunko-tray.desktop |
    install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/mokuro-bunko-tray.desktop"

  local icon
  for icon in packaging/icons/hicolor/*/apps/mokuro-bunko.*; do
    install -Dm644 "$icon" "$pkgdir/usr/share/icons/${icon#packaging/icons/}"
  done

  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE THIRD-PARTY-LICENSES.md

  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md CHANGELOG.md \
    docs/configuration.md docs/deployment.md docs/MIGRATING-0.7.md \
    docs/ocr-internals.md docs/troubleshooting.md
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname/examples" \
    config.example.yaml docs/processor.example.yaml
}
